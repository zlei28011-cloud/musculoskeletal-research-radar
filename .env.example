# Optional: improves PubMed rate limits and identifies your client.
NCBI_API_KEY=
NCBI_EMAIL=researcher@example.com
CROSSREF_MAILTO=researcher@example.com

# Optional SMTP delivery. When absent, HTML emails are still written to dist/reports/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
SMTP_USE_TLS=true

# Runtime paths / tuning
RADAR_DB=data/radar.db
RADAR_CONFIG=config/radar.json
RADAR_OUTPUT=dist
RADAR_LOG_LEVEL=INFO
